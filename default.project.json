{
  "name": "Scrapcraft",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Scrapcraft": {
        "$className": "Folder"
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 17.5,
        "Brightness": 2,
        "Ambient": [0.35, 0.33, 0.30],
        "OutdoorAmbient": [0.35, 0.33, 0.30],
        "Technology": "ShadowMap",
        "GlobalShadows": true
      }
    }
  }
}
